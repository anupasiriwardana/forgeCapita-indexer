# forgeCapita indexer environment (v2)

# Postgres connection string (Neon). Placeholder only.
# Use Neon's DIRECT connection (host WITHOUT "-pooler"), not the pooled one. Ponder sets the schema with a
# session-level `SET search_path`, which the pooled (transaction-mode) endpoint does not keep: the built-in
# /ready and /status routes then fail with: relation "_ponder_meta" does not exist.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Ponder database schema. MUST be "ponder" so the indexer never writes into
# the API's default (public) schema. package.json scripts also pass
# "--schema ponder" for dev and start, which takes precedence over this value.
DATABASE_SCHEMA=ponder

# RPC endpoints
PONDER_RPC_URL_421614=https://YOUR-ARBITRUM-SEPOLIA-RPC
PONDER_RPC_URL_97=https://YOUR-BSC-TESTNET-RPC
# Optional extra endpoints per chain for failover (placeholders). Deduplicated with the primary.
# Either variable may hold several URLs separated by commas, e.g.
#   PONDER_RPC_URL_97_FALLBACK=https://FALLBACK-ONE,https://FALLBACK-TWO
# If everything is unset the public default RPC is used. Only add hosts that pass the burst test
# (see the README): one capped or throttled host can slow the whole chain.
# PONDER_RPC_URL_421614_FALLBACK=https://YOUR-ARBITRUM-SEPOLIA-FALLBACK-RPC
# PONDER_RPC_URL_97_FALLBACK=https://YOUR-BSC-TESTNET-FALLBACK-RPC

# Local debugging only: expose Ponder's read-only SQL endpoint at /sql/*.
# Default off; ignored when NODE_ENV=production. Never needed by the API/frontend.
# ENABLE_SQL_API=true

# Contract addresses (v2 deployment; public, same on both chains)
ARB_FACTORY_ADDRESS=0x246Ffa3Bf583a15e92e17FAa32d3663C17204d52
ARB_P2P_ADDRESS=0xd2540297eB8FC0985b5fa26cba2358db0a0AE914
ARB_REGISTRY_ADDRESS=0x2e6A22fd249930b9F2905D1bD66443CbE366AacB
BSC_FACTORY_ADDRESS=0x246Ffa3Bf583a15e92e17FAa32d3663C17204d52
BSC_P2P_ADDRESS=0xd2540297eB8FC0985b5fa26cba2358db0a0AE914
BSC_REGISTRY_ADDRESS=0x2e6A22fd249930b9F2905D1bD66443CbE366AacB

# Optional start block overrides (defaults are the v2 deployment blocks)
# ARB_START_BLOCK=324727776
# BSC_START_BLOCK=140034644
