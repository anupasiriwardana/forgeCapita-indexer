# forgeCapita indexer environment (v2)

# Postgres connection string (Neon). Placeholder only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Ponder database schema. MUST be "ponder" so the indexer never writes into
# the API's default (public) schema. package.json scripts also pass
# "--schema ponder" for dev and start, which takes precedence over this value.
DATABASE_SCHEMA=ponder

# RPC endpoints
PONDER_RPC_URL_421614=https://YOUR-ARBITRUM-SEPOLIA-RPC
PONDER_RPC_URL_97=https://YOUR-BSC-TESTNET-RPC

# Contract addresses (v2 deployment; public, same on both chains)
ARB_FACTORY_ADDRESS=0x246Ffa3Bf583a15e92e17FAa32d3663C17204d52
ARB_P2P_ADDRESS=0xd2540297eB8FC0985b5fa26cba2358db0a0AE914
ARB_REGISTRY_ADDRESS=0x2e6A22fd249930b9F2905D1bD66443CbE366AacB
BSC_FACTORY_ADDRESS=0x246Ffa3Bf583a15e92e17FAa32d3663C17204d52
BSC_P2P_ADDRESS=0xd2540297eB8FC0985b5fa26cba2358db0a0AE914
BSC_REGISTRY_ADDRESS=0x2e6A22fd249930b9F2905D1bD66443CbE366AacB

# Optional start block overrides (defaults are the v2 deployment blocks)
# ARB_START_BLOCK=324727776
# BSC_START_BLOCK=140034644
